<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Hexa.NET.ImGui\Hexa.NET.ImGui.csproj" />
	</ItemGroup>

	<!-- A PackageReference gets this from the package's buildTransitive targets. -->
	<ItemGroup>
		<NativeFileReference Include="..\..\Hexa.NET.ImGui\native\browser-wasm\cimgui.a" />
	</ItemGroup>

</Project>
